{
  "name": "generic-appjsonl-policy",
  "producer": "acme-llm-proxy 2.4 (synthetic; stands in for an application-layer LLM proxy)",
  "description": "As generic-appjsonl, with the chain rooted in the policy digest and a replayable decision function.",
  "record_class_field": "class",
  "marker_classes": [
    "EPOCH_START",
    "END"
  ],
  "non_event_classes": [
    "EPOCH_START",
    "END",
    "DROP",
    "COVERAGE",
    "POLICY"
  ],
  "integrity": {
    "mechanism": "sha256-chain-canonical",
    "hash_field": "hash",
    "primitive": "SHA-256",
    "documented": true,
    "primitive_documented": true,
    "root": {
      "kind": "field_of_first_record",
      "field": "policy_digest",
      "transform": "sha256"
    },
    "end_marker": {
      "class": "END",
      "head_field": "head",
      "self_bound": true
    }
  },
  "loss": {
    "mode": "declaration",
    "declaration_class": "DROP",
    "count_field": "lost",
    "overflow_behaviour": "drop_counted",
    "produced": {
      "kind": "sum_of_end_marker_fields",
      "fields": [
        "records",
        "lost_total"
      ]
    },
    "interval_fields": [
      "from_seq",
      "to_seq"
    ],
    "event_ordinal_field": "seq"
  },
  "coverage": {
    "mode": "enumerated",
    "declaration_class": "COVERAGE",
    "attached_field": "attached",
    "unattached_field": "unattached_here",
    "by_design_field": "excluded_by_design",
    "basis_field": "basis",
    "bidirectional_test": {
      "exists": true,
      "negative_control": true,
      "ref": "coverage_test.sh"
    }
  },
  "policy": {
    "mode": "chain_root",
    "digest_field": "policy_digest",
    "change_class": "POLICY",
    "replay": {
      "deterministic": true,
      "reference": "policy bundle retrievable by digest; acme-policy-eval --digest <d> --replay <record> reproduces the verdict"
    }
  },
  "independence": {
    "mode": "in_process",
    "audited_process_can_write_records": true,
    "boundary_statement": "The proxy writes its own log in its own address space. A workload that compromises the proxy, or an agent that bypasses it by making the call another way, controls or evades the record entirely."
  }
}
