// Deploys the public VLC-1 page (docs/index.html) as a static Worker.
// Cloudflare Workers Builds runs `npx wrangler deploy` on every push to main.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vlc-1",
  "compatibility_date": "2026-10-19",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  // 2026-11-25, additive: outbound mail via Cloudflare Email Sending
  // (sending domain mail.moore-labs.com, onboarded in the dashboard).
  // Used for double opt-in confirmations and operator notifications.
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [{ "name": "SIGNUPS", "class_name": "Signups" }]
  },
  "migrations": [
    { "tag": "v1-signups", "new_sqlite_classes": ["Signups"] }
  ]
}
